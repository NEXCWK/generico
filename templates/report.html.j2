<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Relatório Semanal — Nex</title>
</head>
<body style="margin:0;padding:0;background:#F5F5F5;font-family:Arial,Helvetica,sans-serif;color:#000000;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F5F5;padding:32px 0;">
<tr><td align="center">
<table role="presentation" width="680" cellpadding="0" cellspacing="0" style="background:#FFFFFF;max-width:680px;width:100%;">

  <!-- Header -->
  <tr><td style="background:#000000;padding:32px 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:22px;color:#FFFFFF;letter-spacing:0.5px;">NEX</td>
        <td align="right" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#FFD400;font-weight:bold;text-transform:uppercase;letter-spacing:1px;">Relatório Semanal</td>
      </tr>
    </table>
  </td></tr>

  <!-- Title / period -->
  <tr><td style="padding:36px 40px 8px 40px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:26px;color:#000000;line-height:1.2;">Performance Comercial — Semana</div>
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#2A2A2A;margin-top:6px;">{{ period.start_label }} até {{ period.end_label }}</div>
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#2A2A2A;margin-top:2px;">Gerado em {{ generated_at }}</div>
  </td></tr>

  <!-- Divider -->
  <tr><td style="padding:20px 40px 0 40px;"><div style="border-top:1px solid #E5E5E5;"></div></td></tr>

  <!-- KPI summary cards -->
  <tr><td style="padding:28px 40px 0 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
      {% for kpi in totals %}
        <td width="20%" valign="top" style="padding:0 {{ '0' if loop.last else '8' }}px 0 {{ '0' if loop.first else '8' }}px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F5F5;border:1px solid #E5E5E5;border-radius:8px;">
            <tr><td style="padding:16px 14px;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#2A2A2A;text-transform:uppercase;letter-spacing:0.5px;font-weight:bold;">{{ kpi.label }}</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:20px;color:#000000;font-weight:bold;margin-top:6px;">{{ kpi.value }}</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;margin-top:8px;color:{{ '#0A7D34' if kpi.wow_dir == 'up' else ('#C0392B' if kpi.wow_dir == 'down' else '#2A2A2A') }};">
                {{ kpi.wow_arrow }} {{ kpi.wow_pct }} <span style="color:#2A2A2A;">vs sem. ant.</span>
              </div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;margin-top:2px;color:{{ '#0A7D34' if kpi.dtm_dir == 'up' else ('#C0392B' if kpi.dtm_dir == 'down' else '#2A2A2A') }};">
                {{ kpi.dtm_arrow }} {{ kpi.dtm_pct }} <span style="color:#2A2A2A;">D2M vs mês ant.</span>
              </div>
            </td></tr>
          </table>
        </td>
      {% endfor %}
      </tr>
    </table>
  </td></tr>

  <!-- Per-line breakdown -->
  <tr><td style="padding:40px 40px 0 40px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:18px;color:#000000;border-left:4px solid #FFD400;padding-left:10px;">Detalhamento por Linha</div>
  </td></tr>

  {% for line in lines %}
  <tr><td style="padding:20px 40px 0 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E5E5E5;border-radius:8px;overflow:hidden;">
      <tr><td colspan="2" style="background:#000000;padding:10px 16px;">
        <span style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:14px;color:#FFFFFF;">{{ line.name }}</span>
      </td></tr>
      {% for metric in line.metrics %}
      <tr>
        <td style="padding:10px 16px;border-top:1px solid #E5E5E5;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#2A2A2A;width:40%;">{{ metric.label }}</td>
        <td style="padding:10px 16px;border-top:1px solid #E5E5E5;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#000000;text-align:right;">
          <span style="font-weight:bold;">{{ metric.value }}</span>
          <span style="color:{{ '#0A7D34' if metric.wow_dir == 'up' else ('#C0392B' if metric.wow_dir == 'down' else '#2A2A2A') }};margin-left:8px;">{{ metric.wow_arrow }} {{ metric.wow_pct }}</span>
          <span style="color:#2A2A2A;margin-left:6px;">| D2M {{ metric.dtm_arrow }} {{ metric.dtm_pct }}</span>
        </td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endfor %}

  <!-- Insights -->
  <tr><td style="padding:44px 40px 0 40px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:18px;color:#000000;border-left:4px solid #FFD400;padding-left:10px;">Visões &amp; Insights</div>
  </td></tr>
  {% for insight in insights %}
  <tr><td style="padding:16px 40px 0 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F5F5;border-radius:8px;">
      <tr><td style="padding:14px 16px;">
        <div style="font-family:Arial,Helvetica,sans-serif;font-weight:bold;font-size:13px;color:#000000;">{{ insight.title }}</div>
        <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#2A2A2A;margin-top:4px;line-height:1.5;">{{ insight.text }}</div>
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  <!-- Footer -->
  <tr><td style="padding:44px 40px 32px 40px;">
    <div style="border-top:1px solid #E5E5E5;padding-top:20px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#2A2A2A;">
      Relatório automático — Nex Coworking · Fonte: Reportei (RD Station Marketing, RD CRM, Google Ads) e Painel de Vendas Nex.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
